#!/usr/bin/env bash
# bin/rig-ci-tools — install the pinned shellcheck and actionlint that
# bin/rig-check runs, into DIR (default ~/.local/bin). Used by CI so that
# what passes does not depend on the runner image.
#
# Usage: rig-ci-tools [DIR]

set -euo pipefail

RIG_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$RIG_HOME/lib/common.sh"
# shellcheck source=../lib/pins.sh
. "$RIG_HOME/lib/pins.sh"

dest="${1:-$RIG_LOCAL_BIN}"
mkdir -p "$dest"
plat="$(rig_platform)" || { rig_warn "unsupported platform"; exit 1; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# $1 name  $2 url  $3 sha256  $4 path of the binary in the archive
install_pinned() {
    local name="$1" url="$2" sha="$3" member="$4"
    [ -n "$sha" ] || { rig_warn "$name: no pinned digest for $plat"; return 1; }
    rig_fetch "$url" "$work/$name.archive" || { rig_warn "$name: download failed"; return 1; }
    rig_sha256_ok "$work/$name.archive" "$sha" || { rig_warn "$name: digest mismatch"; return 1; }
    tar -xf "$work/$name.archive" -C "$work" "$member"
    install -m 0755 "$work/$member" "$dest/$name"
    rig_log "$name: installed $(rig_first_line "$("$dest/$name" --version </dev/null 2>&1)")"
}

case "$plat" in
    linux_amd64) sc_arch=x86_64 ;;
    linux_arm64) sc_arch=aarch64 ;;
esac
sc_sha="RIG_SHELLCHECK_SHA256_$plat"
al_sha="RIG_ACTIONLINT_SHA256_$plat"

install_pinned shellcheck \
    "https://github.com/koalaman/shellcheck/releases/download/v$RIG_SHELLCHECK_VERSION/shellcheck-v$RIG_SHELLCHECK_VERSION.linux.$sc_arch.tar.xz" \
    "${!sc_sha:-}" "shellcheck-v$RIG_SHELLCHECK_VERSION/shellcheck"
install_pinned actionlint \
    "https://github.com/rhysd/actionlint/releases/download/v$RIG_ACTIONLINT_VERSION/actionlint_${RIG_ACTIONLINT_VERSION}_$plat.tar.gz" \
    "${!al_sha:-}" actionlint
