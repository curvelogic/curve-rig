#!/usr/bin/env bash
# bin/rig-relay — the beads relay. See docs/relay.md.
#
# Usage:
#   rig-relay stage [LABEL]   In a cloud session, from inside a member repo:
#                             stage the session's beads changes as a file
#                             and push it alone on a branch
#                             beads-inbox/<time>-<label>.
#   rig-relay push FILE       Push a delta already staged in .beads/inbox/
#                             (to retry after `stage` could not push).
#   rig-relay bootstrap       CI only: install pinned bd and dolt and
#                             materialise the store over https.
#   rig-relay collect DIR     CI only: read every inbox branch's delta, as
#                             data, into DIR; reject malformed branches.
#   rig-relay apply DIR       CI only: apply DIR's deltas behind the
#                             staleness gate and push refs/dolt/data.
#   rig-relay finish DIR      CI only: delete the applied inbox branches;
#                             fail naming any rejected or refused.
#
# The CI commands refuse to run outside GitHub Actions unless
# RIG_RELAY_ALLOW_CI=1: they push the store, and only the member's default
# branch workflow should do that.

set -euo pipefail

RIG_HOME="$(cd "$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"
export RIG_HOME

# shellcheck source=../lib/common.sh
. "$RIG_HOME/lib/common.sh"
# shellcheck source=../lib/relay.sh
. "$RIG_HOME/lib/relay.sh"

usage() { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in -h|--help|"") usage; exit 0 ;; esac

repo="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    rig_warn "not inside a git repository"; exit 1; }
[ -d "$repo/.beads" ] || { rig_warn "$repo has no .beads directory"; exit 1; }
# Without the session hook's TMPDIR, bd refuses a store in the cloud
# layout; set the same for this run's bd calls (see rig_bd_tmpdir).
bd_tmpdir="$(rig_bd_tmpdir "$repo")"
[ -z "$bd_tmpdir" ] || export TMPDIR="$bd_tmpdir"

ci_only() {
    [ "${GITHUB_ACTIONS:-}" = true ] || [ "${RIG_RELAY_ALLOW_CI:-}" = 1 ] || {
        rig_warn "rig-relay $1 runs in CI only (set RIG_RELAY_ALLOW_CI=1 to override)"
        exit 1
    }
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift
case "$cmd" in
    stage)
        rig_ensure_path
        rig_relay_stage "$repo" "${1:-}"
        ;;
    push)
        [ -n "${1:-}" ] || { usage >&2; exit 2; }
        rig_relay_push "$repo" "$1"
        ;;
    bootstrap)
        ci_only bootstrap
        # shellcheck source=../lib/pins.sh
        . "$RIG_HOME/lib/pins.sh"
        # shellcheck source=../lib/beads.sh
        . "$RIG_HOME/lib/beads.sh"
        RIG_LOG=/dev/stderr
        rig_ensure_path
        trap 'rig_restore_all' EXIT
        trap 'rig_on_signal' INT TERM
        rig_install_dolt && rig_install_bd && rig_bootstrap_beads "$repo"
        ;;
    collect|finish)
        ci_only "$cmd"
        [ -n "${1:-}" ] || { usage >&2; exit 2; }
        "rig_relay_$cmd" "$repo" "$1"
        ;;
    apply)
        ci_only apply
        [ -n "${1:-}" ] || { usage >&2; exit 2; }
        # shellcheck source=../lib/beads.sh
        . "$RIG_HOME/lib/beads.sh"
        rig_ensure_path
        trap 'rig_restore_all' EXIT
        trap 'rig_on_signal' INT TERM
        rig_relay_apply "$repo" "$1"
        ;;
    *) rig_warn "unknown command: $cmd"; usage >&2; exit 2 ;;
esac
