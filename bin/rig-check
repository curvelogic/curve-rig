#!/usr/bin/env bash
# bin/rig-check — the check command. Run before every commit; CI runs it too.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

status=0
fail() { printf 'FAIL: %s\n' "$*" >&2; status=1; }
# A linter that is not installed is skipped locally, but fails CI, which
# installs pinned versions (bin/rig-ci-tools).
missing() {
    if [ "${CI:-}" = true ]; then fail "$1 not installed"
    else echo "note: $1 not installed; skipped (bin/rig-ci-tools installs it)" >&2; fi
}

# Shell: every tracked script, by shebang or extension.
mapfile -t scripts < <(
    git ls-files | while IFS= read -r f; do
        case "$f" in
            *.sh) echo "$f" ;;
            *) head -c 64 "$f" 2>/dev/null | grep -q '^#!/usr/bin/env bash' && echo "$f" ;;
        esac
    done
)
for f in "${scripts[@]}"; do
    bash -n "$f" || fail "syntax: $f"
done
if command -v shellcheck >/dev/null 2>&1; then
    shellcheck -x "${scripts[@]}" || fail "shellcheck"
else
    missing shellcheck
fi

# Workflows.
if command -v actionlint >/dev/null 2>&1; then
    actionlint || fail "actionlint"
else
    missing actionlint
fi

# JSON: every tracked file parses.
while IFS= read -r f; do
    jq empty "$f" 2>/dev/null || fail "invalid JSON: $f"
done < <(git ls-files '*.json')

# Manifests: every marketplace entry points at a plugin whose name matches.
market=.claude-plugin/marketplace.json
while IFS=$'\t' read -r name source; do
    manifest="$source/.claude-plugin/plugin.json"
    if [ ! -f "$manifest" ]; then
        fail "marketplace entry '$name': no $manifest"
    elif [ "$(jq -r .name "$manifest")" != "$name" ]; then
        fail "marketplace entry '$name': $manifest names '$(jq -r .name "$manifest")'"
    fi
done < <(jq -r '.plugins[] | [.name, .source] | @tsv' "$market")

[ "$status" -eq 0 ] && echo "rig-check: ok"
exit "$status"
