#!/usr/bin/env bash
# bin/rig-hook-test — prove, inside one cloud session, that an installed rig
# fires its SessionStart hook for a new Claude Code session.
#
# Usage: rig-hook-test [--trusted-owners OWNER[,OWNER...]] [PROMPT]
#
# Installs rig into a throwaway CLAUDE_CONFIG_DIR (the real ~/.claude is not
# touched), starts a headless `claude -p` from the current directory, and
# prints what the SessionStart hook said and the skills the session loaded.
# Fails unless the hook ran and rig's skills were loaded.
#
# Without --trusted-owners the owner is a made-up one, so every repository
# is reported as skipped: that proves the hook fires without provisioning
# anything. With real owners it provisions the session's repositories as a
# real startup would (installing bd and dolt, bootstrapping beads stores).
#
# Needs `claude` on PATH and a session it can authenticate in.

set -euo pipefail

RIG_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

owners="example-nobody"
prompt="Reply OK."
while [ "$#" -gt 0 ]; do
    case "$1" in
        --trusted-owners) owners="${2:-}"; shift 2 ;;
        --trusted-owners=*) owners="${1#*=}"; shift ;;
        -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) prompt="$1"; shift ;;
    esac
done

command -v claude >/dev/null 2>&1 || { echo "rig-hook-test: claude not on PATH" >&2; exit 1; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
export CLAUDE_CONFIG_DIR="$work/claude"
export XDG_CONFIG_HOME="$work/config" XDG_STATE_HOME="$work/state"
unset RIG_TRUSTED_OWNERS

"$RIG_HOME/bin/rig-install" --trusted-owners "$owners" >/dev/null

start=$(date +%s)
rc=0
timeout 960 claude -p --output-format stream-json --verbose "$prompt" \
    </dev/null >"$work/out.jsonl" 2>"$work/err.txt" || rc=$?
secs=$(( $(date +%s) - start ))

hook="$(jq -r 'select(.type == "system" and .subtype == "hook_response"
                      and .hook_event == "SessionStart") | .output // ""' \
        "$work/out.jsonl" 2>/dev/null)"
skills="$(jq -r 'select(.type == "system" and .subtype == "init")
                 | .skills[]? | select(startswith("rig-"))' \
          "$work/out.jsonl" 2>/dev/null)"

printf 'claude exited %s after %ss\n' "$rc" "$secs"
printf -- '--- SessionStart hook output\n%s\n' "${hook:-(none)}"
printf -- '--- rig skills loaded\n%s\n' "${skills:-(none)}"
printf -- '--- hook log\n'
cat "$XDG_STATE_HOME/curve-rig/session-start.log" 2>/dev/null | tail -n 20 || true

status=0
jq -s -e 'any(.[]; .type == "system" and .subtype == "hook_response"
                     and .hook_event == "SessionStart")' "$work/out.jsonl" >/dev/null 2>&1 ||
    { echo "FAIL: SessionStart hook did not run" >&2; status=1; }
[ -n "$skills" ] || { echo "FAIL: no rig skills loaded" >&2; status=1; }
[ "$rc" -eq 0 ] || { tail -n 5 "$work/err.txt" >&2; status=1; }
[ "$status" -eq 0 ] && echo "rig-hook-test: ok"
exit "$status"
